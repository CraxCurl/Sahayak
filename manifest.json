{
  "manifest_version": 3,
  "name": "Sahayak - AI Web Adapter",
  "version": "1.0.0",
  "description": "AI-powered browser extension adapting any webpage using Google Gemma",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel"
  ],
  "options_page": "options.html",
  "host_permissions": [
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/extension/background/service-worker.ts",
    "type": "module"
  },
  "icons": {
    "16": "assets/icons/logo small.jpeg",
    "48": "assets/icons/logo small.jpeg",
    "128": "assets/icons/logo.jpeg"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/logo small.jpeg",
      "48": "assets/icons/logo small.jpeg",
      "128": "assets/icons/logo.jpeg"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["chrome://*", "chrome-extension://*", "about:*"],
      "js": ["src/extension/content/content-script.ts"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "src/dom/overlays/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
